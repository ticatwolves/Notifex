# Copy to .env for local overrides (never commit .env). docker-compose.yml
# already sets working local defaults; only put overrides here.
# In AWS these come from the ECS task definition + Secrets Manager/SSM.

NOTIFEX_ENV=local          # local | dev | staging | prod
LOG_LEVEL=debug            # debug | info | warn | error
LOG_FORMAT=text            # json in every deployed env

HTTP_ADDR=:8080
GRPC_ADDR=:9090
OPS_ADDR=:9100
SHUTDOWN_TIMEOUT=20s

DATABASE_URL=postgres://notifex:<password>@localhost:54320/notifex?sslmode=disable  # compose maps Postgres to host port 54320

# HMAC pepper for API key hashes (base64, >= 32 bytes). Secrets Manager in AWS.
# Generate: openssl rand -base64 32
API_KEY_PEPPER=<base64-32-bytes>
# Local KeyProvider master key (base64, exactly 32 bytes). Local only.
NOTIFEX_LOCAL_MASTER_KEY=<base64-32-bytes>

# System email and links (verification, password reset).
SMTP_ADDR=localhost:1025                  # Mailpit; UI at http://localhost:8025
MAIL_FROM=Notifex <noreply@notifex.local>
CONSOLE_BASE_URL=http://localhost:3000
PASSWORD_HASH_CONCURRENCY=4
# CIDRs whose X-Forwarded-For is trusted (the ALB). Empty = trust none.
TRUSTED_PROXIES=

AWS_REGION=ap-south-1
SQS_ENDPOINT=http://localhost:9324   # ElasticMQ; must be empty outside local

# Tracing: start Jaeger with `docker compose --profile obs up -d jaeger`, then:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
# OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER_RATIO=1.0
